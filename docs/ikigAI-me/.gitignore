# Runtime state — regenerable, sometimes large
state/*
!state/README.md
log.md
feedback.jsonl

# Inbox — temporary, processed asynchronously by THE WATCHER
inbox/**/*.md
inbox/**/*.txt
inbox/**/*.html
!inbox/README.md
inbox/**/.processed/

# Calendar pulls — re-pullable from Google Calendar; can grow large
wiki/calendar/

# Brief outputs (regenerable; can flood with daily files)
# Comment out the next line if you want to keep brief history in git
# wiki/outputs/brief-*.md

# Secrets, OAuth tokens, API keys
**/secrets.yml
**/secrets.json
**/oauth_token.json
**/*-token.json
**/*-credentials.json
**/.env
**/*.key
**/*.pem

# Temp / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Vector index (when run locally rather than on NUC)
**/chroma/
**/graph.json
